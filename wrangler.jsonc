{
  // neungae.com 루트 허브 (Cloudflare Workers 정적 자산)
  "name": "neungae-hub",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "neungae.com", "custom_domain": true },
    { "pattern": "www.neungae.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
